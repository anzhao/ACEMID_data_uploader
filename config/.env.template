# XNAT Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file to version control

# XNAT server URL (always use HTTPS)
XNAT_URL="https://your_xnat_url"

# XNAT credentials
# Consider using a dedicated service account with minimal permissions
XNAT_USERNAME=""
XNAT_PASSWORD=""

# Project ID
XNAT_PROJECT_ID=""

# Security settings
# Set to 1 to enable strict certificate validation (recommended for production)
STRICT_CERT_VALIDATION=1

# Set to 1 to enable debug logging (disable in production)
DEBUG_LOGGING=0

# Timeout settings (in seconds)
CONNECTION_TIMEOUT=30