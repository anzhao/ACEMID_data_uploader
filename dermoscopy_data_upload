#!/bin/bash

# dermoscopy_data_upload - Script for uploading dermoscopy data to XNAT
# This script has been updated with security improvements

# Load utility scripts
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/utils/load_config.sh"
source "$SCRIPT_DIR/utils/input_validation.sh"
source "$SCRIPT_DIR/utils/file_utils.sh"
source "$SCRIPT_DIR/utils/logging.sh"
source "$SCRIPT_DIR/utils/network_utils.sh"

# Initialize logging
LOG_FILE="${LOG_FILE:-/var/log/dermoscopy_uploader.log}"
init_logging "$LOG_FILE"

log_info "Starting dermoscopy data upload process"

# Check if the user has provided a csv input file or not
if [ -z "$1" ]; then
  log_error "No input CSV file provided"
  echo "Usage: $0 <input_csv_file>."
  exit 1
fi

input_file="$1"

# Validate the input file
if ! validate_file_exists "$input_file" "Input CSV file"; then
  log_error "Input CSV file does not exist: $input_file"
  exit 1
fi

# Validate the input file is a CSV
if [[ ! "$input_file" =~ \.csv$ ]]; then
  log_error "Input file is not a CSV file: $input_file"
  echo "Error: Input file must be a CSV file."
  exit 1
fi

# Ensure csvkit is installed, we use it to process the csv files
if ! command -v csvcut &> /dev/null || ! command -v csvgrep &> /dev/null; then
  log_error "csvkit is not installed"
  echo "csvkit is required but not installed. Install it using 'pip install csvkit'."
  exit 1
fi

log_info "Processing CSV file: $input_file"

# Extract unique PatientMRN values
log_debug "Extracting unique PatientMRN values"
patient_mrns=$(csvcut -c PatientMRN "$input_file" | tail -n +2 | sort | uniq)
if [ -z "$patient_mrns" ]; then
  log_error "No PatientMRN values found in the CSV file"
  echo "Error: No PatientMRN values found in the CSV file."
  exit 1
fi

log_info "Found patient MRNs: $patient_mrns"
echo "Patient mrn is: $patient_mrns"

# Extract unique ImagePath values
log_debug "Extracting unique ImagePath values"
patient_image_path=$(csvcut -c ImagePath "$input_file" | tail -n +2 | sort | uniq)
if [ -z "$patient_image_path" ]; then
  log_error "No ImagePath values found in the CSV file"
  echo "Error: No ImagePath values found in the CSV file."
  exit 1
fi

# Extract the part before the forward slash and remove the unwanted characters
patient_image_path=$(echo "$patient_image_path" | awk -F'/' '{print $1}' | sed 's/=HYPERLINK(""//; s/"")//' | tr -d '"' | head -n 1)
log_info "Patient image path is: $patient_image_path"
echo "Patient image path is: $patient_image_path"

# Create a directory to store the output csv files ordered by per patient
output_dir="per_patient_csv_files"
log_info "Creating output directory: $output_dir"
create_secure_dir "$output_dir"

# Split the CSV file based on unique PatientMRN values and remove specified columns
log_info "Splitting CSV file by patient MRN"
while IFS= read -r mrn; do
  # Validate MRN is not empty
  if ! validate_not_empty "$mrn" "Patient MRN"; then
    log_warning "Empty MRN found, skipping"
    continue
  fi
  
  log_info "Processing patient MRN: $mrn"
  
  # Create secure temporary files
  temp_file=$(create_secure_temp_file "temp_${mrn}")
  output_file="$output_dir/patient_${mrn}.csv"
  
  # Extract rows for the current PatientMRN
  log_debug "Extracting data for patient MRN: $mrn"
  csvgrep -c PatientMRN -m "$mrn" "$input_file" > "$temp_file"
  
  # Remove specified columns containing PHI
  log_debug "Removing PHI columns from data"
  csvcut -C LastName,FirstName,DOB,PatientNotes "$temp_file" > "$output_file"
  
  # Remove the temporary file securely
  secure_remove "$temp_file"
  
  log_info "Created file: $output_file"
  echo "Created file: $output_file"
done <<< "$patient_mrns"

log_info "Split csv files ordered by per patient created in directory: $output_dir"
echo "Split csv files ordered by per patient created in directory: $output_dir"

# The zip file contains all the dermoscopy images (jpg or png) to the corresponding patient.
FILE_PATH="${patient_image_path}.zip"

# Validate the zip file exists
if ! validate_file_exists "$FILE_PATH" "Image zip file"; then
  log_error "Image zip file does not exist: $FILE_PATH"
  echo "Error: Image zip file does not exist: $FILE_PATH"
  exit 1
fi

log_info "Processing zip file: $FILE_PATH"

# Create XNAT session
log_info "Creating XNAT session"
JS_ID=$(create_xnat_session)
if [ $? -ne 0 ] || [ -z "$JS_ID" ]; then
  log_error "Failed to create XNAT session"
  echo "Error: Failed to create XNAT session. Check your credentials and XNAT URL."
  exit 1
fi

# Process each patient MRN
for SUBJECT_ID in $patient_mrns
do
  # Validate subject ID
  if ! validate_not_empty "$SUBJECT_ID" "Subject ID"; then
    log_warning "Empty Subject ID found, skipping"
    continue
  fi
  
  log_info "Processing subject: $SUBJECT_ID"
  
  SUBJECT_LABEL=$SUBJECT_ID
  SESSION_ID=$SUBJECT_ID
  SESSION_LABEL=$SESSION_ID
  SCAN_ID="1"
  
  # Create the subject ID
  log_info "Creating subject: $SUBJECT_ID"
  RESPONSE=$(xnat_api_call "/data/archive/projects/$XNAT_PROJECT_ID/subjects/$SUBJECT_ID?label=$SUBJECT_LABEL" "PUT" "" "$JS_ID")
  
  if [ "$RESPONSE" -ne 200 ] && [ "$RESPONSE" -ne 201 ]; then
    log_error "Failed to create subject. HTTP response code: $RESPONSE"
    echo "Failed to create subject. HTTP response code: $RESPONSE"
    continue
  fi

  # Create the session
  SESSION_TYPE="xnat:xcSessionData"
  log_info "Creating session: $SESSION_ID"
  RESPONSE=$(xnat_api_call "/data/archive/projects/$XNAT_PROJECT_ID/subjects/$SUBJECT_ID/experiments/$SESSION_ID?xsiType=$SESSION_TYPE&label=${SESSION_LABEL}" "PUT" "" "$JS_ID")
  
  if [ "$RESPONSE" -ne 200 ] && [ "$RESPONSE" -ne 201 ]; then
    log_error "Failed to create session. HTTP response code: $RESPONSE"
    echo "Failed to create session. HTTP response code: $RESPONSE"
    continue
  fi

  # Create the scan
  SCAN_TYPE="xnat:xcScanData"
  log_info "Creating scan: $SCAN_ID"
  RESPONSE=$(xnat_api_call "/data/archive/projects/$XNAT_PROJECT_ID/subjects/$SUBJECT_ID/experiments/${SESSION_ID}/scans/$SCAN_ID?xsiType=$SCAN_TYPE" "PUT" "" "$JS_ID")
  
  if [ "$RESPONSE" -ne 200 ] && [ "$RESPONSE" -ne 201 ]; then
    log_error "Failed to create scan. HTTP response code: $RESPONSE"
    echo "Failed to create scan. HTTP response code: $RESPONSE"
    continue
  fi

  # Upload the file with extraction
  log_info "Uploading file: $FILE_PATH for subject $SUBJECT_ID"
  curl --cookie JSESSIONID=$JS_ID -X PUT "$XNAT_URL/data/projects/$XNAT_PROJECT_ID/subjects/$SUBJECT_ID/experiments/${SESSION_ID}/scans/$SCAN_ID/resources/RAW/files?extract=true" -F "file=@$FILE_PATH"
  
  if [ $? -ne 0 ]; then
    log_error "Failed to upload file: $FILE_PATH for subject $SUBJECT_ID"
    echo "Failed to upload file: $FILE_PATH for subject $SUBJECT_ID"
    continue
  fi
  
  log_info "Successfully uploaded file for subject: $SUBJECT_ID"
done

log_info "Upload complete!"
echo "Upload complete!"

